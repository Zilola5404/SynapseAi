{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "prisma db push",
    "db:generate": "prisma generate",
    "test": "tsx scripts/test-stages.ts",
    "backtest": "tsx scripts/run-backtest.ts",
    "test:backend": "tsx scripts/test-stages.ts",
    "test:stage1:db": "tsx scripts/test-stage1-db.ts",
    "test:stage1": "tsx server/crypto/apiKeys.test.ts",
    "test:stage2": "tsx server/market/stage2.test.ts",
    "test:stage3": "tsx server/risk.test.ts",
    "test:stage4": "tsx server/binanceErrors.test.ts",
    "test:stage5": "tsx server/services/aiService.test.ts",
    "test:telegram": "tsx scripts/test-telegram.ts",
    "test:execution": "tsx server/trading/executionLayer.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.16.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "grammy": "^1.46.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "undici": "^8.10.1",
    "vite": "^6.2.3",
    "ws": "^8.21.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
