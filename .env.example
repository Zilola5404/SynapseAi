# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (docker compose публикует 5433)
DATABASE_URL="postgresql://synapse:synapse@localhost:5433/synapseai"

# AES-256-GCM: ровно 64 hex-символа (32 байта). Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# JWT
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Gemini (опционально: без ключа работает quant-fallback)
GEMINI_API_KEY=""

# Telegram-бот — основной клиент бекенда
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Опциональный системный ключ Binance (пользовательские ключи хранятся в БД)
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BINANCE_USE_TESTNET="true"

# Live trading выключен, пока не пройден paper + testnet
ALLOW_LIVE="false"

APP_URL="http://localhost:3000"
