# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (docker compose публикует 5433)
DATABASE_URL="postgresql://synapse:synapse@localhost:5433/synapseai"

# AES-256-GCM: ровно 64 hex-символа (32 байта). Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# JWT
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Gemini (опционально: без ключа работает quant-fallback)
GEMINI_API_KEY=""

# Telegram-бот — основной клиент бекенда
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Если api.telegram.org недоступен (часто в РФ) — HTTP-прокси, например Clash:
# TELEGRAM_PROXY="http://127.0.0.1:7890"
TELEGRAM_PROXY=""
# Или свой Bot API / зеркало:
# TELEGRAM_API_ROOT="https://api.telegram.org"
TELEGRAM_API_ROOT=""

# Опциональный системный ключ Binance (пользовательские ключи хранятся в БД, не в Git)
# Реальные ключи не коммитить.
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BINANCE_USE_TESTNET="true"
# Алиас: BINANCE_TESTNET=true включает Futures Testnet
BINANCE_TESTNET="true"
# REST USD-M Demo/Testnet (ключи с https://demo.binance.com, не с живого binance.com)
# BINANCE_FUTURES_TESTNET_URL="https://demo-fapi.binance.com"

# Live trading выключен, пока не пройден paper + testnet
ALLOW_LIVE="false"

# Market data: Futures REST (не Spot). PAPER/LIVE → fapi.binance.com
# TESTNET: production futures by default. Set true only if you want testnet candles.
MARKET_DATA_USE_TESTNET="false"
# Optional override, e.g. https://fapi.binance.com
MARKET_DATA_API_ROOT=""
MARKET_DATA_TIMEOUT_MS="15000"

# Docker compose app service uses postgres hostname, not localhost:
# DATABASE_URL="postgresql://synapse:synapse@postgres:5432/synapseai"

APP_URL="http://localhost:3000"
